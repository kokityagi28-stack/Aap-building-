rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check if user is a member of the participants list
    function isParticipant(participants) {
      return isSignedIn() && request.auth.uid in participants;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 255
        && data.displayName is string && data.displayName.size() <= 100
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['creator', 'client']
        && (data.bio == null || (data.bio is string && data.bio.size() <= 1000))
        && (data.skills == null || (data.skills is list && data.skills.size() <= 20))
        && (data.categories == null || (data.categories is list && data.categories.size() <= 10));
    }

    function isValidPortfolio(data) {
      return data.creatorId == request.auth.uid 
        && data.type in ['video', 'image', 'audio']
        && data.url is string && data.url.size() <= 500
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && (data.tags == null || (data.tags is list && data.tags.size() <= 10));
    }

    function isValidReview(data) {
      return data.clientId == request.auth.uid
        && data.creatorId is string && isValidId(data.creatorId)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.receiverId is string && isValidId(data.receiverId)
        && data.text is string && data.text.size() <= 2000;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get, list: if true; // Public for discovery
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'email', 'role', 'displayName', 'photoURL', 'bio', 'skills', 'categories', 'socialLinks', 'updatedAt', 'followerCount', 'followingCount', 'rating', 'reviewCount'])
        );
    }

    match /portfolios/{portfolioId} {
      allow get, list: if true;
      
      allow create: if isSignedIn() || (request.auth == null && incoming().type in ['video', 'image', 'audio']);
      
      allow update: if (isSignedIn() && (isOwner(existing().creatorId) || existing().creatorId == request.auth.uid))
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['url', 'thumbnailUrl', 'title', 'description', 'tags', 'updatedAt', 'likesCount', 'commentsCount'])
        );
      
      allow delete: if isSignedIn() && (isOwner(existing().creatorId) || existing().creatorId == request.auth.uid);

      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow delete: if isOwner(existing().userId);
      }
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow write: if isOwner(followerId);
    }

    match /users/{userId}/following/{followingId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) && incoming().creatorId == userId;
      allow update, delete: if isOwner(existing().clientId);
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(existing().participants);
      allow create: if isParticipant(incoming().participants);
      allow update: if isParticipant(existing().participants);

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow create: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          && isValidMessage(incoming());
      }
    }
  }
}
